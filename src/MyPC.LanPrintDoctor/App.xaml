<Application x:Class="MyPC.LanPrintDoctor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBgDeep}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Foreground" Value="#FF111318"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
