<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgDeep">#FF0B0D10</Color>
  <Color x:Key="BgPanel">#FF151922</Color>
  <Color x:Key="BgElevated">#FF1C2230</Color>
  <Color x:Key="AccentGold">#FFE0B84A</Color>
  <Color x:Key="TextPrimary">#FFF2F4F8</Color>
  <Color x:Key="TextMuted">#FF9AA3B2</Color>
  <Color x:Key="PassGreen">#FF3DDC97</Color>
  <Color x:Key="WarnAmber">#FFE0B84A</Color>
  <Color x:Key="FailRed">#FFFF5C5C</Color>
  <Color x:Key="UnknownGray">#FF7A8494</Color>

  <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource BgDeep}"/>
  <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource BgPanel}"/>
  <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource BgElevated}"/>
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentGold}"/>
  <SolidColorBrush x:Key="BrushText" Color="{StaticResource TextPrimary}"/>
  <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource TextMuted}"/>
  <SolidColorBrush x:Key="BrushPass" Color="{StaticResource PassGreen}"/>
  <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource WarnAmber}"/>
  <SolidColorBrush x:Key="BrushFail" Color="{StaticResource FailRed}"/>
  <SolidColorBrush x:Key="BrushUnknown" Color="{StaticResource UnknownGray}"/>
</ResourceDictionary>
