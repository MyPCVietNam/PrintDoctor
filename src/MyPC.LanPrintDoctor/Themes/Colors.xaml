<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Gate A palette (v1.2.2-HF2) — WCAG AA on dark panels -->
  <Color x:Key="BgDeep">#FF0B0F16</Color>
  <Color x:Key="BgPanel">#FF171D28</Color>
  <Color x:Key="BgElevated">#FF202838</Color>
  <Color x:Key="TextPrimary">#FFF2F4F8</Color>
  <Color x:Key="TextMuted">#FFBBC5D3</Color>
  <Color x:Key="AccentGold">#FFE0B84A</Color>
  <Color x:Key="PassGreen">#FF3DDC97</Color>
  <Color x:Key="WarnAmber">#FFF1C453</Color>
  <Color x:Key="FailRed">#FFFF7474</Color>
  <Color x:Key="UnknownGray">#FFBBC5D3</Color>
  <Color x:Key="OnAccent">#FF0B0F16</Color>
  <Color x:Key="BorderSubtle">#FF2A3344</Color>

  <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource BgDeep}"/>
  <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource BgPanel}"/>
  <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource BgElevated}"/>
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentGold}"/>
  <SolidColorBrush x:Key="BrushText" Color="{StaticResource TextPrimary}"/>
  <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource TextMuted}"/>
  <SolidColorBrush x:Key="BrushPass" Color="{StaticResource PassGreen}"/>
  <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource WarnAmber}"/>
  <SolidColorBrush x:Key="BrushFail" Color="{StaticResource FailRed}"/>
  <SolidColorBrush x:Key="BrushUnknown" Color="{StaticResource UnknownGray}"/>
  <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource OnAccent}"/>
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderSubtle}"/>
  <SolidColorBrush x:Key="BrushStatusReady" Color="{StaticResource TextMuted}"/>
  <SolidColorBrush x:Key="BrushStatusBusy" Color="{StaticResource WarnAmber}"/>
  <SolidColorBrush x:Key="BrushStatusOk" Color="{StaticResource PassGreen}"/>
  <SolidColorBrush x:Key="BrushStatusError" Color="{StaticResource FailRed}"/>
</ResourceDictionary>
