<Window x:Class="MyPC.LanPrintDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPC LAN &amp; Print Doctor"
        Height="720" Width="1100"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0B0D10" Offset="0"/>
        <GradientStop Color="#FF121826" Offset="0.55"/>
        <GradientStop Color="#FF1A1520" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Brand hero strip -->
    <Border Grid.Row="0" Padding="28,22,28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="MyPC LAN &amp; Print Doctor" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
          <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox Width="110" SelectedIndex="{Binding LanguageIndex}" Margin="0,0,8,0">
            <ComboBoxItem Content="Tiếng Việt"/>
            <ComboBoxItem Content="English"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,8,28,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Controls -->
      <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="18">
        <StackPanel>
          <TextBlock Text="{Binding Labels.Role}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Content="{Binding Labels.Server}" IsChecked="{Binding IsServerRole}" Margin="0,0,16,0" Foreground="{StaticResource BrushText}"/>
            <RadioButton Content="{Binding Labels.Client}" IsChecked="{Binding IsClientRole}" Foreground="{StaticResource BrushText}"/>
          </StackPanel>

          <TextBlock Text="{Binding Labels.TargetIp}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,14"
                   Background="{StaticResource BrushBgElevated}" Foreground="{StaticResource BrushText}" BorderBrush="#FF2A3344"/>

          <Button Content="{Binding Labels.Scan}" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0,0,0,8"/>
          <Button Content="{Binding Labels.Causes}" Style="{StaticResource GhostButton}" Command="{Binding ShowCausesCommand}" Margin="0,0,0,8"/>
          <Button Content="{Binding Labels.SafeRepair}" Style="{StaticResource GhostButton}" Command="{Binding SafeRepairCommand}" Margin="0,0,0,8"/>
          <Button Content="{Binding Labels.Export}" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}" Margin="0,0,0,8"/>
          <Button Content="{Binding Labels.Compare}" Style="{StaticResource GhostButton}" Command="{Binding CompareCommand}" Margin="0,0,0,16"/>

          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}"/>
          <TextBlock Text="{Binding SessionText}" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource BrushUnknown}"/>
        </StackPanel>
      </Border>

      <!-- Results -->
      <Border Grid.Column="2" Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="18">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Labels.Findings}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding DetailHint}" Foreground="{StaticResource BrushMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <ListBox ItemsSource="{Binding Findings}" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource BrushBgElevated}" CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="88"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" FontWeight="Bold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="28,10,28,16">
      <TextBlock>
        <Hyperlink NavigateUri="https://mypc.vn" RequestNavigate="BrandLink_OnRequestNavigate">
          <Run Text="Phát triển bởi MyPC Việt Nam ↗" Foreground="{StaticResource BrushAccent}"/>
        </Hyperlink>
      </TextBlock>
    </Border>
  </Grid>
</Window>
